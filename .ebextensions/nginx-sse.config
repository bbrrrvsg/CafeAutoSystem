files:
  "/etc/nginx/conf.d/sse_timeout.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      # SSE(Server-Sent Events) 연결은 장시간 유지되므로 별도 timeout 설정
      location /api/sse/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 3600s;
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
      }
